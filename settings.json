{
    "git.ignoreLegacyWarning": true, // Disables warning about legacy Git versions
    "update.mode": "manual", // Disables automatic updates, requires manual update checks
    "editor.fontSize": 18, // Sets editor font size to 18px
    "editor.lineHeight": 0,
    "window.zoomLevel": 0,
    "editor.fontFamily": "'Fira Code'", // Uses Fira Code font with ligatures in editor
    "editor.fontLigatures": true, // Enables font ligatures (special combined characters)
    "terminal.integrated.fontFamily": "monospace", // Sets terminal font to system monospace
    "terminal.integrated.fontSize": 16.5, // Sets terminal font size to 16.5px
    "output.integrated.fontFamily": "monospace", // Sets output panel font to monospace
    "output.integrated.fontSize": 16.5, // Sets output panel font size to 16.5px
    "workbench.panel.defaultLocation": "bottom", // Positions panels (terminal, output, etc.) on the right side
    "editor.formatOnSave": false, // Disables automatic formatting on file save
    "editor.guides.bracketPairs": true, // Shows vertical guides for bracket pairs
    "editor.guides.highlightActiveIndentation": true, // Highlights active indentation level
    "editor.guides.bracketPairsHorizontal": false, // Disables horizontal bracket pair guides
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true, // Uses different color pools for different bracket types
    "better-comments.multilineComments": true, // Enables better-comments extension for multiline comments
    //  From Glenn Raya U-Tube Video -
    "editor.copyWithSyntaxHighlighting": false, // Disables syntax highlighting when copying text
    "editor.emptySelectionClipboard": false, // Prevents copying empty selection
    "window.newWindowDimensions": "inherit", // New windows inherit dimensions from current window
    "files.trimTrailingWhitespace": true, // Automatically removes trailing whitespace on save
    "diffEditor.renderSideBySide": false, // Shows diff editor in inline view instead of side-by-side
    "editor.snippetSuggestions": "top", // Shows code snippets at top of suggestion list
    "editor.detectIndentation": false, // Disables automatic indentation detection
    "window.nativeFullScreen": true, // Uses native full screen mode (macOS specific)
    "files.insertFinalNewline": true, // Adds final newline at end of file on save
    "workbench.editor.showTabs": "multiple", // Shows editor tabs even when only one file is open
    "editor.lineNumbers": "on", // Shows line numbers in editor
    "editor.guides.indentation": false, // Disables indentation guides
    // Few More -
    "breadcrumbs.enabled": false, // Disables breadcrumbs navigation bar
    "scm.diffDecorations": "none", // Disables source control diff decorations
    "editor.hover.delay": 1000, // Sets 1 second delay before showing hover info
    "editor.hover.above": true,
    "editor.hover.enabled": "on", // Enables editor hover information
    "editor.matchBrackets": "near", // Highlights matching brackets when cursor is near them
    "workbench.tips.enabled": false, // Disables welcome tips on startup
    "editor.colorDecorators": false, // Disables color decorators in editor
    "git.decorations.enabled": false, // Disables Git decorations in editor
    "workbench.startupEditor": "none", // Opens empty editor on startup
    "editor.lightbulb.enabled": "off", // Disables lightbulb code action indicators
    "editor.selectionHighlight": true, // Highlights all matches of current selection
    "editor.overviewRulerBorder": false, // Hides overview ruler border
    "editor.renderLineHighlight": "none", // Disables line highlight (current line indicator)
    "editor.occurrencesHighlight": "singleFile", // Highlights symbol occurrences in current file only
    "problems.decorations.enabled": false, // Disables problem decorations in editor
    "editor.renderControlCharacters": false, // Hides control characters in editor
    "editor.gotoLocation.multipleReferences": "goto", // Behavior when multiple references exist (go to first)
    "editor.gotoLocation.multipleDefinitions": "goto",
    "editor.gotoLocation.multipleDeclarations": "goto",
    "workbench.editor.enablePreviewFromQuickOpen": false, // Disables editor preview mode from quick open
    "editor.gotoLocation.multipleImplementations": "goto",
    "editor.gotoLocation.multipleTypeDefinitions": "goto",
    "vscode_custom_css.imports": [
        "file:///E:/githubRepo/vscode-settings-json/custom-vscode-css.css",
        "file:///E:/githubRepo/vscode-settings-json/vscode-script.js"
    ],
