    "editor.linkedEditing": true, // Enables linked editing for HTML/XML tags
    "gitlens.defaultDateFormat": "YYYY-MM-DDTHH:mm:ss", // GitLens date format configurations
    "gitlens.defaultDateShortFormat": "YYYY-MM-DD",
    "gitlens.defaultDateStyle": "absolute",
    "workbench.sideBar.location": "right", // Positions sidebar on the left
    "workbench.activityBar.location": "top", // making explorer bar icons to top
    "sync.gist": "d37e16972c485e6e66f6b7fc7d77c6ce", // Settings Sync extension configuration
    "files.defaultLanguage": "", // No default language for new files
    "editor.suggest.showStatusBar": true, // Shows status bar during suggestions
    "editor.suggest.insertMode": "insert", // Insert mode for suggestions (vs replace)
    "workbench.settings.editor": "json", // Uses JSON editor for settings
    "workbench.editor.highlightModifiedTabs": true, // Highlights modified tabs
    "editor.cursorBlinking": "expand", // Cursor blinks with expand animation
    "files.trimFinalNewlines": true, // Removes multiple final newlines on save
    "editor.cursorSmoothCaretAnimation": "on", // Enables smooth caret animation
    "breadcrumbs.enable": true, // Enables breadcrumbs navigation
    "breadcrumbs.filePath": "on", // Shows file path in breadcrumbs
    "editor.wordWrap": "on", // Enables word wrapping
    "workbench.editor.enablePreview": false, // Disables editor preview mode
    "php.validate.enable": false, // PHP specific settings
    "php.suggest.basic": false,
    "phpfmt.indent_with_space": 4,
    "phpfmt.cakephp": true,
    "phpfmt.passes": [
        "AlignTypehint",
        "AlignDoubleArrow",
        "AlignDoubleSlashComments"
    ],
    "phpfmt.psr2": false,
    "explorer.confirmDelete": false, // Disables confirmation dialogs for delete/drag operations
    "explorer.confirmDragAndDrop": false,
    "liveServer.settings.donotShowInfoMsg": true, // Live Server extension settings
    "[html]": { // Default formatters for different file types
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "[javascript][javascriptreact][typescript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[json][jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[css][scss][less]": {
        "editor.defaultFormatter": "vscode.css-language-features"
    },
    "terminal.integrated.enableMultiLinePasteWarning": "never", // Disables multi-line paste warning in terminal
    "explorer.openEditors.visible": 2, // Shows 2 open editors in explorer
    "emmet.includeLanguages": { // Includes JSX in JavaScript Emmet suggestions
        "javascript": "javascriptreact"
    },
    "workbench.colorCustomizations": { // Custom theme color modifications
        "[Material Theme Ocean High Contrast]": {
            "tab.activeBorderTop": "#04ff00"
        },
        "editorLineNumber.foreground": "#fff", // Makes non-active line numbers brighter/denser
        "editorLineNumber.activeForeground": "#fff" // Keeps the active line highly visible
    },
    "terminal.integrated.tabs.defaultIcon": "bell", // Sets default terminal tab icon
    "js/ts.updateImportsOnFileMove.enabled": "always", // Updates imports automatically when moving files
    "files.exclude": { // File exclusion patterns
        ".gitignore": false
    },
    "editor.minimap.enabled": false, // Disables minimap
    "editor.quickSuggestions": { // Enables quick suggestions in all contexts
        "other": true,
        "comments": true,
        "strings": true
    },
    "git.openRepositoryInParentFolders": "never", // Never opens Git repos in parent folders
    "better-comments.highlightPlainText": true, // Enables Better Comments in plain text files
